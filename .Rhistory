#Points to append fetch to
### Plot Raw Data
ggplot()+
geom_sf(data=LO_shapefile, colour = "black", fill="lightblue", inherit.aes = FALSE)+
#geom_point(data = LO_data_raw,
#            aes(x=Latitude, y=Longitude), colour="firebrick", alpha=0.5)+
ylab("Longitude")+xlab("Latitude")+
theme_classic()
# 1. shrink the polygon by 10 km, then cut that out of the original
inner <- st_buffer(LO_shapefile, dist = -10000)
band  <- st_difference(st_geometry(LO_shapefile), st_geometry(inner))
lo <- LO_shapefile |>
st_zm(drop = TRUE, what = "ZM") |>
st_transform(3347) |>          # Statistics Canada Lambert, meters
st_make_valid()
poly <- st_union(st_geometry(lo))   # single geometry
# 2. shoreline band: polygon minus a 10 km inward buffer
inner <- st_buffer(poly, dist = -10000)
