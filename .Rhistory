## Load packages
library(ggplot2)
library(spdep)
## import data
df <- read.csv("~/Document Reviews/Thesis/Agostini/NA_LeafTraits2023_2024_2025_withRepsExcel.csv")
## explore/pilot
## species with higher #s
## ELCA - 215 ** use as pilot
## NYOD - 302
df.2<-subset(df,Species.Code=="ELCA")
df.2$SLA..mm.2.mg.[df.2$SLA..mm.2.mg. == -328000.00] <- NA
## basic plots of metrics
plot(LA..mm.2.~Depth.of.sample..cm.,data=df.2)
boxplot(LA..mm.2.~factor(Depth.of.sample..cm.),data=df.2) ## looks to drop off ~110-120 cm
plot(LDMC..unitless. ~Depth.of.sample..cm.,data=df.2) ## insufficient data
plot(SLA..mm.2.mg. ~Depth.of.sample..cm.,data=df.2) ## insufficient data
## plot the value of interest spatially
ggplot(df.2, aes(x = Site.Long, y = Site.Lat, colour = LA..mm.2.)) +
geom_point(size = 5) +
scale_colour_viridis_c() +
coord_equal() +
theme_classic()
coords <- cbind(df.2$Site.Long, df.2$Site.Lat) ## extract coordinates
nb <- knn2nb(knearneigh(coords, k = 5)) ## nearest neighbour stats
lw <- nb2listw(nb, style = "W")
moran.test(df.2$LA..mm.2., lw) ## Moran's I test for spatial autocorrelation
moran.mc(df.2$LA..mm.2., lw, nsim = 999)
moran.plot(df.2$LA..mm.2., lw)
## local Moran (where is the SA?)
local_moran <- localmoran(df.2$LA..mm.2., lw)
df.2$Ii <- local_moran[, "Ii"]
df.2$pvalue <- local_moran[, "Pr(z != E(Ii))"]
## plot the local effects
ggplot(df.2, aes(x=Site.Long, y = Site.Lat,, colour = Ii)) +
geom_point(size = 3) +
scale_colour_viridis_c() +
theme_classic()
df.2$cluster <- ifelse(df.2$pvalue < 0.05, "Significant", "NS")
ggplot(df.2, aes(x=Site.Long, y = Site.Lat, colour = cluster)) +
geom_point(size = 3)+
theme_classic() ## flags two areas where it may be an issue...
head(df.2)
str(df.2)
ggplot(df.2, aes(x=factor(Site.ID), y = LA..mm.2., colour = cluster)) +
boxplot()+
theme_classic() ## flags two areas where it may be an issue...
ggplot(df.2, aes(x=factor(Site.ID), y = LA..mm.2., colour = cluster)) +
geom_boxplot()+
theme_classic() ## flags two areas where it may be an issue...
ggplot(df.2, aes(x=factor(Site.ID), y = LA..mm.2.)) +
geom_boxplot()+
theme_classic() ## flags two areas where it may be an issue...
View(df.2)
